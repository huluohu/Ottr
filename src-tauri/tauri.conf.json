{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ottr",
  "version": "0.1.0",
  "identifier": "com.ottr.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ottr",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://releases.ottr.invalid/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "REPLACE_WITH_UPDATER_PUBKEY__GENERATE_VIA__npx_tauri_signer_generate__CI_SECRET_INJECT_OR_REPLACE_AT_PACKAGING"
    }
  }
}
