# 生成的密钥与运行时产物（勿入库）
spike_ed25519*
hostkeys/
known_hosts
# spike-sshd.sh keyscan 循环的中转文件：sshd 未就绪时残留（BL-212，勿入库）
known_hosts.tmp
# ftpd 自签证书（spike-ftpd.sh 生成，勿入库）
ftpd/cert.pem
ftpd/key.pem
# ftpd 宿主进程形态的运行时产物（spike-ftpd.sh 生成，勿入库）：pidfile、
# 依赖 venv、FTP 传输根目录（测试中断时残留传输产物）
ftpd/ftpd.pid
ftpd/.venv/
ftpd/home/
